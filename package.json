    "gate:P3-B": "tsx tests/gates/P3-B.ts",
    "gate:P3-E": "tsx tests/gates/P3-E.ts",
    "measure:e2e": "tsx scripts/measure-e2e.ts",
    "capture:discovery": "tsx scripts/capture-discovery.ts"
