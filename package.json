{
  "name": "confidential-agents",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "//build": "`build` is the tsc -b solution build over the Node packages. A Next.js project does not belong in that graph, so the web app is a separate step and `build:all` is the one that covers everything.",
    "build": "tsc -b",
    "build:all": "pnpm build && pnpm --filter @ca/web build",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b && pnpm --filter @ca/web typecheck",
    "gate:P0-A": "tsx tests/gates/P0-A.ts",
    "gate:P0-B": "tsx tests/gates/P0-B.ts",
    "gate:P0-D": "tsx tests/gates/P0-D.ts",
    "gate:P0-E": "tsx tests/gates/P0-E.ts",
    "gate:P0-F": "tsx tests/gates/P0-F.ts",
    "gate:P0-G": "tsx tests/gates/P0-G.ts",
    "gate:P1-A": "tsx tests/gates/P1-A.ts",
    "gate:P1-B": "tsx tests/gates/P1-B.ts",
    "gate:P1-C": "tsx tests/gates/P1-C.ts",
    "gate:P1-D": "tsx tests/gates/P1-D.ts",
    "gate:P2-A": "tsx tests/gates/P2-A.ts",
    "gate:P2-B": "tsx tests/gates/P2-B.ts",
    "gate:P2-C": "tsx tests/gates/P2-C.ts",
