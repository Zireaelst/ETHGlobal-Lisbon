# .env — GERÇEK .env ASLA COMMIT EDİLMEZ. Sadece atılabilir testnet anahtarları.
# Alan isimleri BUILD-PLAN P0-A ile birebir aynıdır — iki dev de aynı isimleri kullanır.

# --- Base Sepolia ---
BASE_RPC_URL=https://sepolia.base.org
PRIVATE_KEY_ALICE=
PRIVATE_KEY_BOB=
PRIVATE_KEY_DEPLOYER=
VERIFIER_ADDRESS=
ERC8004_IDENTITY=
USDC_BASE_SEPOLIA=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# ERC-8004 agentId'leri — P0-F kapısı doldurur
ALICE_AGENT_ID=
BOB_AGENT_ID=
# Bob'un dışarıdan erişilebilir adresi — zincire endpoint olarak bu yazılır (P2-A).
# P5-A'da public bir URL olacak; boşsa localhost kullanılır ve kapı bunu belirtir.
BOB_PUBLIC_URL=

# --- 0G ---
OG_RPC_URL=https://evmrpc-testnet.0g.ai
OG_PRIVATE_KEY=
OG_PROVIDER_ADDRESS=
OG_TAPP_ENDPOINT=
OG_AGENT_ID=

# --- Hedera ---
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_NETWORK=testnet
HEDERA_TOPIC_ID=
BLOCKY402_URL=https://api.testnet.blocky402.com
BLOCKY402_FEE_PAYER=0.0.7162784

# --- The Graph ---
GRAPH_DEPLOY_KEY=
SUBGRAPH_SLUG=
THEGRAPH_API_KEY=
# subgraph.yaml startBlock'u — yanlışsa subgraph boş indeksler (P0-F kapısı doldurur)
SUBGRAPH_START_BLOCK=

# --- Anahtarlar (ECIES, P1-B'de üretilir) ---
ALICE_ECIES_PRIV=
BOB_ECIES_PRIV=

# --- Mod anahtarları ---
MOCK_0G=0
FRAUD_MODE=none
